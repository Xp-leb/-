    int age = 20;
    
    int years = age;
    int days = years * DAYS_PER_YEAR;
    int hours = days * HOURS_PER_DAY;
    int ticks = hours * SECONDS_PER_HOUR;
    
    printf("Тики: %d|Часы: %d|Дни: %d|Годы: %d\n", ticks, hours, days, years);
   
    return(0);
}


